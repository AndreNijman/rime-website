---
// /download (spec §6.6, §16). Renders ONLY what content/downloads.json holds,
// and that file is generated from the published GitHub release
// (scripts/fetch-downloads.mjs), checksums cross-checked. Nothing here
// advertises an installer, architecture or method CI did not publish.
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import CommandChip from "../components/CommandChip.astro";
import downloads from "../../content/downloads.json";
import RemoteDownload from "../components/RemoteDownload.astro";
const cur = downloads.current, iso = cur.artifacts.find((a) => a.kind === "iso")!;
// Present only when the release carries a verified Windows app.
const win = cur.artifacts.find((a) => a.kind === "windows-installer");
const prev = downloads.previous;
const gb = (b: number) => (b / 1e9).toFixed(2) + " GB";
const date = new Date(cur.publishedAt).toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "Australia/Perth" });
const shortName = cur.name.split(" — ")[0];
---
<Base title="Download" description={`Download the Rime network installer (${iso.arch}, ${gb(iso.bytes)}), check it, and install.`}>
  <section class="container dl-hero">
    <p class="eyebrow">Download</p>
    <h1>Get Rime.</h1>
    <p class="lead">A network installer for 64-bit PCs. It downloads the signed system image while it installs. After that, <code>sudo rime update</code> takes each new release, checked against its signature first.</p>

    <div class="dl-card">
      <div class="dl-main">
        <p class="dl-kicker"><span class="chip">Recommended</span><span class="caption">{shortName} · published {date}</span></p>
        <h2 class="dl-file mono">{iso.name}</h2>
        <dl class="dl-facts">
          <div><dt>Architecture</dt><dd>{iso.arch}</dd></div>
          <div><dt>Size</dt><dd class="tnum">{gb(iso.bytes)} <span class="caption">({iso.bytes.toLocaleString("en-AU")} bytes)</span></dd></div>
          <div><dt>Kind</dt><dd>Network installer (needs a connection)</dd></div>
        </dl>
        <div class="dl-actions">
          <a class="btn btn-primary btn-lg" href={iso.url} data-download-start><Icon name="download" /> Download ISO</a>
          <a class="btn btn-lg" href={iso.checksumUrl}>Checksum file</a>
        </div>
      </div>
      <div class="dl-sha">
        <p class="caption">SHA-256</p>
        <CommandChip cmd={iso.sha256} prompt="" label="SHA-256 copied" wrap />
        <p class="caption">From GitHub's own record of the file, and it matches the published <code>.sha256</code>.</p>
      </div>
    </div>
  </section>

  <section class="container section-tight" id="requirements" aria-labelledby="req-h">
    <div class="dl-grid">
      <div>
        <h2 id="req-h">Requirements</h2>
        <dl class="req-list">
          <div><dt>Computer</dt><dd>A 64-bit PC with UEFI. Legacy BIOS can also boot the stick.</dd></div>
          <div><dt>Disk</dt><dd>At least 12 GB (a 10 GB partition beside Windows). 20 GB recommended: Rime keeps the previous version for rollback, and an update that replaces the whole system downloads about 5 GB before it can start.</dd></div>
          <div><dt>Network</dt><dd>A connection during the install.</dd></div>
          <div><dt>USB stick</dt><dd>One that holds {gb(iso.bytes)}. It is overwritten.</dd></div>
          <div><dt>Secure Boot</dt><dd>Optional. The installer offers to enrol Rime's Secure Boot key; with Secure Boot on, the Rime kernel boots only after that key is enrolled. You can skip it and leave Secure Boot off.</dd></div>
        </dl>
      </div>
      <div>
        <h2>Known hardware notes</h2>
        <ul class="hw">
          <li>Wi-Fi networks with a captive portal (sign-in page) don't work in the installer. Use a normal network or Ethernet.</li>
          <li>USB Wi-Fi adapters that need out-of-tree drivers don't work in the installer.</li>
          <li>Tablets without a keyboard can't complete the account page.</li>
          <li>NVIDIA's driver is part of the image and signed with Rime's key, so it loads with Secure Boot on once that key is enrolled.</li>
          <li>Xbox wireless dongles need their firmware fetched once after install; it can't be redistributed.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container section-tight" id="verify" aria-labelledby="ver-h">
    <h2 id="ver-h">Check the download</h2>
    <p class="muted measure">Put the ISO and its checksum file in one folder and run:</p>
    <CommandChip cmd={`sha256sum -c ${iso.name}.sha256`} />
    <p class="muted measure">It prints <code>{iso.name}: OK</code>. Or compare the file's SHA-256 with the one above by eye.</p>
    {iso.provenance && (
      <>
        <p class="muted measure">The checksum proves the file arrived whole, not who made it. GitHub signed a record of that: the ISO was built by <code>{iso.provenance.workflow}</code> on <code>{iso.provenance.ref.replace("refs/heads/", "")}</code>. With the GitHub CLI:</p>
        <CommandChip cmd={`gh attestation verify ${iso.name} -R ${downloads.repo.replace("https://github.com/", "")}`} />
      </>
    )}
    <p class="muted measure">The system image the ISO downloads is signed too, and <code>rime update</code> checks that signature on every update. <a href="/docs/verify">How verification works</a></p>
  </section>

  <section class="container section-tight" id="install" aria-labelledby="inst-h">
    <h2 id="inst-h">Install</h2>
    <ol class="steps steps--plain">
      <li><strong>Write the ISO to a USB stick</strong> with a USB image writer. Everything on the stick is replaced.</li>
      <li><strong>Boot from the stick</strong> from your firmware's boot menu.</li>
      <li><strong>Follow the installer.</strong> Keyboard and time zone come first. The disk you pick is erased only after you type ERASE for that exact disk. Whole-disk encryption is on by default; write down the recovery key it shows you.</li>
      <li><strong>Reboot into Rime.</strong> Encrypted disks ask for the passphrase before anything else. Updates come with <code>sudo rime update</code>, which checks each image's signature first.</li>
    </ol>
    <p><a class="btn" href="/docs/install">Full install guide <Icon name="arrow-right" /></a></p>
    <p class="caption measure">Installing beside Windows from a USB stick: shrink Windows yourself first, then choose the installer's option to install into an existing partition. Or skip the stick and use the Windows app below.</p>
  </section>

  {win && (
    <section class="container section-tight" id="windows" aria-labelledby="win-h">
      <h2 id="win-h">Install from Windows, without a USB stick</h2>
      <p class="measure muted">The Rime installer for Windows puts Rime OS beside Windows on the same disk. It gives Rime its own boot partition, so Windows' boot files are never touched, and it starts Rime's installer once, at the next restart.</p>
      <div class="dl-card">
        <div class="dl-main">
          <p class="dl-kicker"><span class="chip">Windows 10 or 11</span><span class="caption">{shortName}</span></p>
          <h3 class="dl-file mono">{win.name}</h3>
          <dl class="dl-facts">
            <div><dt>Size</dt><dd class="tnum">{(win.bytes / 1e6).toFixed(1)} MB</dd></div>
            <div><dt>Needs</dt><dd>UEFI, administrator rights, internet</dd></div>
            <div><dt>Installs</dt><dd>{iso.name}, checked against its SHA-256</dd></div>
          </dl>
          <div class="dl-actions">
            <a class="btn btn-primary btn-lg" href={win.url}><Icon name="download" /> Download for Windows</a>
            <a class="btn btn-lg" href={win.checksumUrl}>Checksum file</a>
          </div>
        </div>
        <div class="dl-sha">
          <p class="caption">SHA-256</p>
          <CommandChip cmd={win.sha256} prompt="" label="SHA-256 copied" wrap />
          {win.provenance && <p class="caption">Built by <code>{win.provenance.workflow}</code>, attested by GitHub like the ISO.</p>}
        </div>
      </div>
      <ol class="steps steps--plain">
        <li><strong>Make room.</strong> Right-click Start, open Disk Management, right-click C: and choose Shrink Volume. Shrink it by at least 30,000 MB and leave the new space Unallocated.</li>
        <li><strong>Run the installer</strong> and choose that space. It names the disk by model and serial number; check it is the one you meant.</li>
        <li><strong>Restart.</strong> Rime's installer starts once, by itself. Choose your keyboard, connect to the internet, create your account and confirm.</li>
        <li><strong>Afterwards</strong> the computer starts Rime. Windows is in Rime's boot menu, or, if Windows uses BitLocker or Device encryption, in your firmware's boot menu (usually F12, F11, F9 or Esc), so BitLocker never asks for its recovery key.</li>
      </ol>
      <p class="caption measure">Windows may warn that the app is from an unknown publisher: it is not code-signed yet. The SHA-256 above, and <code>gh attestation verify {win.name} -R {downloads.repo.replace("https://github.com/", "")}</code>, prove it is the file GitHub built. Changed your mind before restarting? Run it again and choose Remove the prepared setup.</p>
    </section>
  )}

  <section class="container section-tight" id="remote" aria-labelledby="remote-h">
    <h2 id="remote-h">Rime Remote for Android</h2>
    <p class="measure muted">The phone app for your agent sessions: watch them, reply, pause, stop and start them from anywhere. Pair it from a Rime machine's Settings once it's installed. <a href="/agents#remote">What it does, and what it can't</a>.</p>
    <RemoteDownload heading={false} />
  </section>

  <section class="container section-tight" id="first-update" aria-labelledby="fu-h">
    <h2 id="fu-h" class="h4">Installed from the APEX-OS installer?</h2>
    <p class="caption measure">Machines installed from an APEX-OS ISO (v2.1.0 or older) run an APEX-OS image until their first update, and that first update needs one manual step, because the old update tool trusts only the old signer. Machines installed from this installer are not affected. <a href="/docs/install#the-first-update">The steps</a></p>
  </section>

  {prev && (
    <section class="container section-tight dl-prev" aria-labelledby="prev-h">
      <h2 id="prev-h" class="h4">Previous installer</h2>
      <p class="caption">For recovery only. <a href={prev.url}>{prev.name}</a>, published {new Date(prev.publishedAt).toLocaleDateString("en-AU", { day: "numeric", month: "long", year: "numeric", timeZone: "Australia/Perth" })}.</p>
      {prev.artifacts.map((a) => (
        <p class="caption mono prev-a"><a href={a.url}>{a.name}</a> · {a.bytes.toLocaleString("en-AU")} bytes · sha256 {a.sha256}</p>
      ))}
    </section>
  )}
</Base>

<style>
  .dl-hero { padding-top: calc(var(--notch-h) + clamp(40px, 6vw, 88px)); padding-bottom: 24px; display: grid; gap: 18px; }
  .dl-hero .lead { max-width: 58ch; }
  .dl-card { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(20px, 4vw, 48px); padding: clamp(24px, 4vw, 44px); border-radius: calc(var(--radius-xl) + 6px); background: var(--rime-surface-raised); box-shadow: inset 0 0 0 1px var(--rime-hairline); margin-top: 18px; }
  @media (max-width: 900px) { .dl-card { grid-template-columns: 1fr; } }
  .dl-main { display: grid; gap: 16px; align-content: start; }
  .dl-kicker { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .dl-file { font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem); font-weight: 600; letter-spacing: 0; overflow-wrap: anywhere; }
  .dl-facts { display: flex; flex-wrap: wrap; gap: 14px 32px; margin: 0; }
  .dl-facts dt { font-size: 0.78rem; color: var(--rime-text-secondary); }
  .dl-facts dd { margin: 2px 0 0; font-weight: 600; }
  .dl-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
  @media (max-width: 720px) {
    .dl-actions .btn, #install > p > .btn { flex: 1 1 100%; }
    #install > p:has(> .btn) { display: flex; }
    .dl-card { padding: 22px 18px; }
  }
  .dl-sha { display: grid; gap: 10px; align-content: start; }
  .h4 { font-size: 1.05rem; margin-bottom: 6px; }
  .steps { margin: 4px 0; padding-left: 1.3em; display: grid; gap: 16px; }
  .steps li > p { margin-bottom: 8px; }
  .steps--plain { gap: 10px; max-width: 76ch; margin-bottom: 18px; }
  .dl-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 5vw, 72px); }
  @media (max-width: 900px) { .dl-grid { grid-template-columns: 1fr; } }
  .dl-grid h2, #verify h2, #install h2, #windows h2 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); margin-bottom: 16px; }
  .req-list { margin: 0; border-top: 1px solid var(--rime-hairline); }
  .req-list div { display: grid; grid-template-columns: 120px 1fr; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--rime-hairline); }
  .req-list dt { color: var(--rime-text-secondary); font-size: 0.9rem; }
  .req-list dd { margin: 0; }
  .hw { margin: 0; padding-left: 1.2em; display: grid; gap: 10px; }
  .measure { max-width: 76ch; margin-block: 12px; }
  #verify .cmd { max-width: 900px; }
  .dl-prev { padding-bottom: var(--section-pad); }
  .prev-a { overflow-wrap: anywhere; margin-top: 6px; }
</style>
