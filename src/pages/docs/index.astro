---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
const docs = await getCollection("docs");
const sections = ["Start", "Use", "Reference", "Troubleshooting"] as const;
const by = (s: string) => docs.filter((d) => d.data.section === s).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Docs" description="How to install, update, roll back and look after a Rime machine.">
  <header class="container page-hero">
    <p class="eyebrow">Docs</p>
    <h1>Install, use and look after Rime.</h1>
    <p class="lead">Plain instructions, checked against the source they describe. Search them with <kbd>/</kbd>.</p>
  </header>
  <div class="container docs-index">
    {sections.map((s) => by(s).length > 0 && (
      <section>
        <h2>{s}</h2>
        <ul>
          {by(s).map((d) => <li><a href={`/docs/${d.id}`}><strong>{d.data.title}</strong><span>{d.data.description}</span></a></li>)}
        </ul>
      </section>
    ))}
  </div>
</Base>
<style>
  .page-hero { padding-top: calc(var(--notch-h) + clamp(40px, 6vw, 88px)); padding-bottom: 24px; display: grid; gap: 16px; }
  .docs-index { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px; padding-bottom: var(--section-pad); }
  .docs-index h2 { font-size: 1.15rem; margin-bottom: 12px; color: var(--rime-text-secondary); }
  .docs-index ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .docs-index a { display: grid; gap: 4px; padding: 14px 16px; border-radius: var(--radius-l); background: var(--rime-surface-raised); box-shadow: inset 0 0 0 1px var(--rime-hairline); text-decoration: none; }
  .docs-index a:hover { background: var(--rime-surface-high); }
  .docs-index a span { font-size: 0.9rem; color: var(--rime-text-secondary); }
</style>
