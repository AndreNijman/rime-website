  .compare thead th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--rime-text-secondary); }
  .compare tbody th { width: 14%; color: var(--rime-text-primary); }
  .compare td { color: var(--rime-text-secondary); }
  .compare td:nth-child(2) { color: var(--rime-text-primary); }
