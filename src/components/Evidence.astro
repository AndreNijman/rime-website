---
// EvidenceBlock (spec §11, §13.2): a product line → the mechanism → the source.
// Quiet on purpose; it always links somewhere a reader can check.
interface Props { links?: { label: string; href: string }[]; label?: string }
const { links = [], label = "Evidence" } = Astro.props;
---
<aside class="evidence" aria-label={label}>
  <div class="evidence-body"><slot /></div>
  {links.length > 0 && (
    <ul class="evidence-links">
      {links.map((l) => <li><a href={l.href} class="mono">{l.label}</a></li>)}
    </ul>
  )}
</aside>
<style>
  .evidence {
    border-left: 2px solid var(--rime-accent); padding: 2px 0 2px 16px; max-width: 62ch;
    font-size: 0.95rem; color: var(--rime-text-secondary);
  }
  .evidence :global(code) { font-size: 0.82rem; color: var(--rime-text-primary); }
  .evidence-links { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .evidence-links a { font-size: 0.76rem; color: var(--rime-text-secondary); }
  .evidence-links a:hover { color: var(--rime-text-primary); }
</style>
