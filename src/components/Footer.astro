---
import RimeMark from "./RimeMark.astro";
import Segmented from "./Segmented.astro";
import { FOOTER, SITE } from "../data/site";
---
<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-home"><RimeMark size={18} tone="role" /><span>Rime</span></a>
      <p class="caption">{SITE.tagline}</p>
    </div>
    <nav class="footer-links" aria-label="Footer">
      {FOOTER.map((col) => (
        <ul>{col.map((l) => <li><a href={l.href} class="link-quiet">{l.label}</a></li>)}</ul>
      ))}
      <ul>
        <li><a href="/updates/feed.xml" class="link-quiet">Updates feed</a></li>
        <li><a href={SITE.repos.os} class="link-quiet">rime-os on GitHub</a></li>
        <li><a href={SITE.repos.shell} class="link-quiet">rime-shell on GitHub</a></li>
        <li><a href={SITE.repos.website} class="link-quiet">rime-website on GitHub</a></li>
      </ul>
    </nav>
    <div class="footer-prefs" data-prefs>
      <Segmented name="scheme" label="Appearance" value="dark" options={[
        { value: "auto", label: "Auto" }, { value: "dark", label: "Dark" }, { value: "light", label: "Light" },
      ]} />
      <Segmented name="motion" label="Motion" options={[
        { value: "system", label: "System" }, { value: "full", label: "Full" },
        { value: "reduced", label: "Reduced" }, { value: "off", label: "Off" },
      ]} />
    </div>
  </div>
  <div class="container-wide footer-base">
    <p class="caption">
      Product claims on this site were checked against{" "}
      <a href={`${SITE.repos.os}/tree/${SITE.pinned.os}`} class="mono">rime-os@{SITE.pinned.os}</a>{" "}and{" "}
      <a href={`${SITE.repos.shell}/tree/${SITE.pinned.shell}`} class="mono">rime-shell@{SITE.pinned.shell}</a>.
      No trackers, no analytics.
    </p>
  </div>
</footer>

<script>
  import { initPrefs } from "../scripts/prefs";
  initPrefs();
</script>

<style>
  .site-footer { border-top: 1px solid var(--rime-hairline); padding: 56px 0 40px; margin-top: 0; }
  .footer-grid { display: grid; gap: 40px; grid-template-columns: minmax(180px, 1fr) minmax(0, 2fr) auto; align-items: start; }
  .footer-home { display: inline-flex; align-items: center; gap: 10px; font-weight: 650; font-size: 1.1rem; text-decoration: none; }
  .footer-brand .caption { margin-top: 10px; }
  .footer-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .footer-links ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .footer-links a { font-size: 0.95rem; color: var(--rime-text-secondary); }
  @media (hover: hover) { .footer-links a:hover { color: var(--rime-text-primary); } }
  @media (max-width: 760px), (pointer: coarse) {
    .footer-links ul { gap: 0; }
    .footer-links a { display: flex; align-items: center; min-height: 44px; }
    .footer-home { min-height: 44px; }
  }
  .footer-prefs { display: grid; gap: 16px; justify-items: start; }
  :global(html:not(.js)) .footer-prefs { display: none; }
  .footer-base { margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--rime-hairline); }
  .footer-base a { color: var(--rime-text-secondary); }
  @media (max-width: 980px) { .footer-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .footer-links { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
