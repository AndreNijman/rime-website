---
// Get Rime (spec §12 row 8): requirements and one clear action. The facts come
// from the published release (content/downloads.json and its notes).
import Icon from "./Icon.astro";
import downloads from "../../content/downloads.json";
interface Props { headingId?: string }
const { headingId } = Astro.props;
const iso = downloads.current.artifacts.find((a) => a.kind === "iso")!;
const gb = (iso.bytes / 1e9).toFixed(1);
---
<div class="get">
  <div class="get-copy">
    <h2 id={headingId}>Get Rime.</h2>
    <p class="lead">A network installer for 64-bit PCs. It downloads the signed system image while it installs.</p>
    <div class="get-actions">
      <a class="btn btn-primary btn-lg" href="/download"><Icon name="download" /> Download · {gb} GB</a>
      <a class="btn btn-lg" href="/docs/install">Install guide</a>
    </div>
  </div>
  <dl class="get-req">
    <div><dt>Computer</dt><dd>64-bit PC with UEFI (legacy BIOS can boot the stick)</dd></div>
    <div><dt>Disk</dt><dd>12 GB minimum, 20 GB recommended</dd></div>
    <div><dt>Network</dt><dd>Needed during the install</dd></div>
    <div><dt>Encryption</dt><dd>Whole-disk encryption is on by default, with a recovery key</dd></div>
  </dl>
</div>
<style>
  .get { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  @media (max-width: 900px) { .get { grid-template-columns: 1fr; } }
  .get-copy { display: grid; gap: 18px; justify-items: start; }
  .get-copy h2 { font-size: var(--fs-h1); }
  .get-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
  @media (max-width: 720px) { .get-copy { justify-items: stretch; } .get-actions .btn { flex: 1 1 100%; } }
  .get-req { margin: 0; display: grid; gap: 0; border-top: 1px solid var(--rime-hairline); }
  .get-req div { display: grid; grid-template-columns: 120px 1fr; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--rime-hairline); }
  .get-req dt { color: var(--rime-text-secondary); font-size: 0.9rem; }
  .get-req dd { margin: 0; }
</style>
