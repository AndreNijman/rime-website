---
// ─── ProductStage ───────────────────────────────────────────────────────────
// A Rime desktop, recorded rather than drawn: the real Rime Shell
// (rime-shell's own shell.qml, at the revision in src/data/stage.json) in a
// headless Hyprland at 3840 × 2400 — a 1920 × 1200 desktop, the L16's, at 2× —
// with a fresh install's settings and the palette matugen makes from the
// wallpaper shown. scripts/capture/ records it; scripts/build-stage.mjs
// publishes it. Wi-Fi networks, Bluetooth devices and notifications are canned
// (nothing from a real machine is recorded) and the clock reads 09:41.
//
// The page shows the resting desktop as a still. Each transition (the
// Dashboard out of the centre notch, Wi-Fi and the notification centre out of
// the right one, and between them) is a clip of the part of the screen it
// changes, played over the still: stage.ts. Without JavaScript the stage shows
// a settled surface, the Dashboard or the Agent Center (spec §10.4: never an
// empty stage).
// ────────────────────────────────────────────────────────────────────────────
import Icon from "./Icon.astro";
import stage from "../data/stage.json";

interface Props {
  id: string;
  tour?: boolean;           // run the guided interaction when in view
  controls?: boolean;       // the buttons under the stage
  scene?: string;           // wallpaper / palette id
  caption?: string;
  label?: string;
  eager?: boolean;          // the page's hero asset (spec §14.1: prioritise one)
  reduced?: boolean;        // play this stage's Reduce Motion recordings whatever the visitor's setting
  acts?: Act[];             // the surfaces its buttons open, in order
  still?: "dashboard" | "agents";   // the settled surface shown without JavaScript
}
type Act = "dashboard" | "agents" | "network" | "notifications";
const ACT_LABEL: Record<Act, string> = { dashboard: "Dashboard", agents: "Agents", network: "Wi-Fi", notifications: "Notifications" };
const { id, tour = false, controls = true, scene: sceneId = "rime-default", caption, label = "Recording of the Rime Shell desktop", eager = false, reduced = false,
        acts = ["dashboard", "network", "notifications"], still = "dashboard" } = Astro.props;
type Still = { avif: { w: number; src: string }[]; jpg: string };
const variants = stage.variants as Record<string, { rest?: Still; dashboard?: Still; agents?: Still }>;
const scene = variants[`${sceneId}-dark`] ? sceneId : "rime-default";
const set = (s: Still) => s.avif.map((x) => `${x.src} ${x.w}w`).join(", ");
// The desk is 1920 logical px; on a phone stage.ts shows a 960 px cut of it at
// the stage's width, so the image is drawn at about twice the viewport's width.
const SIZES = "(max-width: 652px) 200vw, (min-width: 1500px) 1400px, 94vw";
const shell = stage.shell;
// "Click" in a caption reads "Tap" on a touch screen (global.css .w-touch).
const capParts = (caption ?? "The real Rime Shell, recorded.").split(/\bClick\b/);
const stills = (["dark", "light"] as const).map((m) => ({ m, v: variants[`${scene}-${m}`] }));
---
<figure class="stage-figure" id={id} data-stage={id} data-tour={tour ? "1" : undefined} data-scene={scene} data-motion={reduced ? "reduced" : undefined}>
  <div class="stage" role="group" aria-roledescription="recording" aria-label={label}>
    <div class="stage-desk" data-desk>
      {stills.map(({ m, v }) => v?.rest && (
        <picture class:list={["stage-base", `stage-base--${m}`]} data-base={m}>
          <source type="image/avif" srcset={set(v.rest)} sizes={SIZES} />
          <img src={v.rest.jpg} alt="" width="3840" height="2400" loading="lazy" decoding="async" fetchpriority={eager ? "high" : "auto"} />
        </picture>
      ))}
      {stills.map(({ m, v }) => v?.[still] && (
        <picture class:list={["stage-nojs", `stage-nojs--${m}`]}>
          <source type="image/avif" srcset={set(v[still]!)} sizes={SIZES} />
          <img src={v[still]!.jpg} alt="" width="3840" height="2400" loading="lazy" decoding="async" />
        </picture>
      ))}
      <div class="stage-clips" data-clips aria-hidden="true"></div>
      <div class="stage-dismiss" data-dismiss aria-hidden="true"></div>
      <button type="button" class="stage-hot hot-dashboard" data-act="dashboard" tabindex="-1" aria-hidden="true"></button>
      <button type="button" class="stage-hot hot-network" data-act="network" tabindex="-1" aria-hidden="true"></button>
      <button type="button" class="stage-hot hot-notifications" data-act="notifications" tabindex="-1" aria-hidden="true"></button>
      {acts.includes("agents") && <>
        <button type="button" class="stage-hot hot-tab hot-tab-home" data-tab="dashboard" tabindex="-1" aria-hidden="true"></button>
        <button type="button" class="stage-hot hot-tab hot-tab-agents" data-tab="agents" tabindex="-1" aria-hidden="true"></button>
      </>}
    </div>
  </div>
  {controls && (
    <div class="stage-controls" data-controls>
      <div class="stage-acts" role="group" aria-label="Open a Shell surface">
        {acts.map((a) => <button type="button" class="stage-act" data-act={a} aria-pressed="false">{ACT_LABEL[a]}</button>)}
      </div>
      {tour && (
        <button type="button" class="stage-tour" data-tour-toggle aria-pressed="true">
          <span class="tour-pause"><Icon name="pause" size={14} /> Pause tour</span>
          <span class="tour-play"><Icon name="play" size={14} /> Play tour</span>
        </button>
      )}
    </div>
  )}
  <figcaption class="stage-caption caption">
    {capParts.map((part, i) => <>{i > 0 && <><span class="w-point">Click</span><span class="w-touch">Tap</span></>}{part}</>)}
    {" "}<a href={`https://github.com/AndreNijman/rime-shell/tree/${shell}`} class="mono">rime-shell@{shell.slice(0, 8)}</a>
  </figcaption>
</figure>

<script>
  import { initStages } from "../scripts/stage";
  initStages();
</script>

<style is:global>
  .stage-figure { margin: 0; }
  .stage {
    position: relative; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; container-type: inline-size;
    border-radius: clamp(14px, 2vw, 26px); background: #000;
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.55), 0 0 0 1px var(--rime-hairline);
    isolation: isolate;
  }
  /* The desk: the recorded 1920 × 1200 desktop. Without JS it fills the stage;
   * stage.ts scales it and, on a phone, cuts and pans it. */
  .stage-desk { position: absolute; inset: 0; transform-origin: 0 0; }
  :root.js .stage-desk { inset: auto; left: 0; top: 0; width: 1920px; height: 1200px; transform: scale(var(--k, 0.7)); }
  .stage-base, .stage-nojs, .stage-base img, .stage-nojs img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .stage-base img, .stage-nojs img { object-fit: cover; }
  /* The page's scheme picks the recording: dark or light. */
  .stage-base--light, .stage-nojs--light { display: none; }
  :root[data-scheme="light"] .stage-base--dark, :root[data-scheme="light"] .stage-nojs--dark { display: none; }
  :root[data-scheme="light"] .stage-base--light, :root[data-scheme="light"] .stage-nojs--light { display: block; }
  @media (prefers-color-scheme: light) {
    :root:not([data-scheme]) .stage-base--dark, :root:not([data-scheme]) .stage-nojs--dark { display: none; }
    :root:not([data-scheme]) .stage-base--light, :root:not([data-scheme]) .stage-nojs--light { display: block; }
  }
  :root.js .stage-nojs { display: none !important; }
  html:not(.js) .stage-base { display: none !important; }
  .stage-base[data-js-hidden] { display: none !important; }
  .stage-clips { position: absolute; inset: 0; pointer-events: none; }
  .stage-clips video, .stage-clips img { position: absolute; display: block; max-width: none; }
  .stage-layer { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Where the real bar's controls are, in the recording's 1920 × 1200 layout:
   * the centre notch (810-1110), the Wi-Fi icon and the bell in the right one. */
  .stage-hot { position: absolute; top: 0; height: 3.4%; border: 0; padding: 0; background: none; cursor: pointer; border-radius: 0 0 14px 14px; }
  html:not(.js) .stage-hot, html:not(.js) .stage-dismiss { display: none; }
  .hot-dashboard { left: 42.2%; width: 15.6%; }
  .hot-network { left: 91.55%; width: 1.5%; }
  .hot-notifications { left: 98.05%; width: 1.5%; }
  /* The open Dashboard's Home and Agents tabs (1920 × 1200: 555-630 and 848-927). */
  .hot-tab { display: none; top: 1.4%; height: 2.8%; border-radius: 999px; z-index: 2; }
  .stage[data-open="dashboard"] .hot-tab, .stage[data-open="agents"] .hot-tab { display: block; }
  .hot-tab-home { left: 28.9%; width: 3.9%; }
  .hot-tab-agents { left: 44.2%; width: 4.1%; }
  .stage-dismiss { position: absolute; inset: 0; display: none; }
  .stage[data-open] .stage-dismiss { display: block; }
  /* Phones: a 4:5 cut of the desktop (stage.ts), at a size you can read. */
  .stage.stage--cut { aspect-ratio: 4 / 5; }
  @media (max-width: 640px) { html:not(.js) .stage { aspect-ratio: 4 / 5; } html:not(.js) .stage-desk { left: -50%; right: auto; width: 200%; } }

  .stage-controls { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-top: 18px; }
  .stage-acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .stage-act, .stage-tour {
    display: inline-flex; align-items: center; gap: 10px; min-height: 40px; padding: 0 16px; border-radius: 999px; border: 0;
    background: var(--rime-surface-raised); color: var(--rime-text-primary); font-weight: 600; font-size: 0.9rem; cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--rime-hairline);
    transition: background-color var(--dur-hover) var(--ease-effects), transform var(--dur-press-out) var(--ease-spring);
  }
  @media (hover: hover) { .stage-act:hover, .stage-tour:hover { background: var(--rime-surface-high); } }
  @media (max-width: 760px), (pointer: coarse) {
    .stage-act, .stage-tour { min-height: 44px; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  }
  .stage-act:active, .stage-tour:active { transform: scale(var(--press-scale)); transition-duration: var(--dur-hover), var(--dur-press-in); }
  .stage-act[aria-pressed="true"] { background: var(--rime-surface-selected); box-shadow: inset 0 0 0 1px var(--rime-outline-strong); }
  .stage-tour .tour-play { display: none; }
  .stage-tour[aria-pressed="false"] .tour-pause { display: none; }
  .stage-tour[aria-pressed="false"] .tour-play { display: inline-flex; }
  .stage-tour span { display: inline-flex; align-items: center; gap: 8px; }
  html:not(.js) .stage-controls { display: none; }
  .stage-caption { margin-top: 14px; max-width: 70ch; }
  .stage-caption a { color: var(--rime-text-secondary); }
</style>
