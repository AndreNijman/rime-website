---
// The lock screen's password shapes, drawn with the Shell's own paths
// (src/data/password-shapes.json, generated from rime-shell's materialpath.js —
// AndroidX graphics-shapes, Apache-2.0). Like PasswordShapes.qml it reads only
// the LENGTH of what you type: the field is a real password field, and nothing
// is shown, sent or stored.
import shapes from "../data/password-shapes.json";
---
<div class="pw" data-pw data-shapes={JSON.stringify(shapes.order.map((k) => shapes.shapes[k as keyof typeof shapes.shapes]))}>
  <label class="pw-label" for="pw-try">Type anything</label>
  <div class="pw-field">
    <div class="pw-row" aria-hidden="true" data-pw-row><span class="pw-caret" data-pw-caret></span></div>
    <input id="pw-try" class="pw-input" type="password" autocomplete="off" maxlength="40" data-pw-input aria-describedby="pw-note" />
    <span class="pw-placeholder" data-pw-ph aria-hidden="true">Enter password</span>
  </div>
  <p id="pw-note" class="caption">Only the length is used, as on the lock screen. Nothing you type leaves this field.</p>
</div>
<script>
  import { initPasswordShapes } from "../scripts/password-shapes";
  initPasswordShapes();
</script>
<style is:global>
  .pw { display: grid; gap: 10px; max-width: 420px; }
  .pw-label { font-size: 0.85rem; font-weight: 600; color: var(--rime-text-secondary); }
  .pw-field {
    position: relative; height: 52px; border-radius: 26px; overflow: hidden;
    background: color-mix(in srgb, var(--rime-surface-base) 55%, transparent);
    box-shadow: inset 0 0 0 2px var(--rime-outline-soft);
    transition: box-shadow var(--dur-state) var(--ease-effects);
  }
  .pw-field:focus-within { box-shadow: inset 0 0 0 2px var(--rime-accent); }
  .pw-input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; border: 0; cursor: text; font-size: 16px; }
  .pw-row { position: absolute; inset: 0 22px; display: flex; align-items: center; gap: 3px; pointer-events: none; }
  .pw-row svg { width: 18px; height: 18px; flex: none; overflow: visible; }
  .pw-row path { fill: var(--rime-accent); }
  .pw-caret { width: 2px; height: 16px; border-radius: 1px; background: var(--rime-accent); opacity: 0; }
  .pw-field:focus-within .pw-caret.on { opacity: 1; }
  .pw-placeholder { position: absolute; left: 22px; top: 50%; transform: translateY(-50%); color: var(--rime-text-secondary); pointer-events: none; font-size: 0.95rem; transition: opacity var(--dur-fade-out) var(--ease-effects); }
  html:not(.js) .pw { display: none; }
</style>
